.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron
.env

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/


# ---- project-specific ----

# temporary simulation output (intermediate results and seed files)
**/sim_results/tmp/

# generated figures (not included in the repository);
